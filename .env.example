# Blackwood Environment Variables

# Tavily API Key (get free at https://tavily.com)
# Without this key, the system falls back to mock data
VITE_TAVILY_API_KEY=tvly_your_key_here

# Comma-separated Supabase Auth emails allowed to open internal operator pages.
# Example: taahirahdenmark09@gmail.com,access.blackwoodoffice@atomicmail.io
VITE_ADMIN_EMAILS=your_admin_email@example.com
